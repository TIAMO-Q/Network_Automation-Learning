# 此时的server就定义了一个用于网络传输，并且采用TCP协议的服务器
server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
# 2.绑定网卡
server.bind(("127.0.0.1", 8081))
# 3.开机
# listen标识了半连接池的容量，此时最多可以容纳5个连接请求
server.listen(5)
# 4.监听连接请求
# (1) 从半连接池当中取出一个链接请求交给accept处理，建立链接
# (2) accept处理完链接请求得到的返回值为一个元组，分别代表真实
#     建成的连接，以及该连接中客户端具体的IP地址信息
while True:
    conn, client_addr = server.accept()
        # # 5. 接受信息，recv表示每次最多接收多少个字节的数据

    while True:
        cmd = conn.recv(1024).decode("utf-8")
        if cmd.__len__() == 0:break
        if cmd.upper() == "Q":break
        obj = subprocess.Popen(args=cmd,
                               shell=True,
                               stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE
                               )
        std_out = obj.stdout.read()
        std_err = obj.stderr.read()
        result = std_out + std_err
        total_size = struct.pack('i',len(result))
        # # 6. 发送消息，使用send方法，只能发从字节类型的数据
        conn.send(total_size)
        conn.send(result)

    # # 7. 关闭连接
    conn.close()
# # # 8. 关闭服务器
